        "Bip001-L-Calf",
        "Bip001-L-Foot"
      ],
      "right_leg": [
        "Bip001-R-Thigh",
        "Bip001-R-Calf",
        "Bip001-R-Foot"
      ]
    },
    "rest_margin": 0.5,
