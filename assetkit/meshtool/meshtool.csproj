<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CUE4ParseDir Condition="'$(CUE4ParseDir)' == ''">$(MSBuildThisFileDirectory)../../.cache/cue4parse</CUE4ParseDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CUE4ParseDir)/CUE4Parse/CUE4Parse.csproj" />
    <ProjectReference Include="$(CUE4ParseDir)/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
  </ItemGroup>

</Project>
